rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profilbild: jeder Angemeldete darf lesen (publicUrl), nur der Besitzer
    // schreibt, hoechstens 1 MB und nur JPEG.
    match /users/{uid}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Story-Medien: Besitzer immer, ein Freund nur solange die Story shared ist.
    match /users/{uid}/stories/{storyId}/{file} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (firestore.exists(/databases/(default)/documents/users/$(uid)/friends/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(uid)/stories/$(storyId)).data.shared == true)
      );
      allow write: if request.auth != null && request.auth.uid == uid && (
        (request.resource.contentType == 'image/jpeg' && request.resource.size < 1 * 1024 * 1024) ||
        (request.resource.contentType == 'audio/mp4' && request.resource.size < 3 * 1024 * 1024)
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
