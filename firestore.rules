rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite lookup: token → { uid, display_name, avatar_url }.
    // Tokens are unguessable UUIDs; get-only (no list, so no enumeration).
    // Only the owning user can create/overwrite/delete their invite doc.
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'display_name', 'avatar_url'])
        && request.resource.data.get('display_name', '') is string
        && request.resource.data.get('display_name', '').size() <= 100
        && request.resource.data.get('avatar_url', '') is string
        && request.resource.data.get('avatar_url', '').size() <= 500;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'display_name', 'avatar_url'])
        && request.resource.data.get('display_name', '') is string
        && request.resource.data.get('display_name', '').size() <= 100
        && request.resource.data.get('avatar_url', '') is string
        && request.resource.data.get('avatar_url', '').size() <= 500;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Users: readable only by the owner and confirmed friends (friend view).
    // No list — invite lookup goes through /invites instead.
    // Write: only by the user themselves, with type/size validation
    match /users/{uid} {
      allow get: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
      );
      allow list: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('display_name', '') is string
        && request.resource.data.get('display_name', '').size() <= 100
        && request.resource.data.get('avatar_url', '') is string
        && request.resource.data.get('avatar_url', '').size() <= 500
        && request.resource.data.get('invite_token', '') is string
        && request.resource.data.get('invite_token', '').size() <= 64
        && request.resource.data.get('visited_countries', [])  is list
        && request.resource.data.get('wishlist_countries', []) is list
        && request.resource.data.get('visited_cities', [])     is list
        && request.resource.data.get('visited_cities', []).size() <= 5000
        && request.resource.data.get('wishlist_cities', [])    is list
        && request.resource.data.get('wishlist_cities', []).size() <= 5000;

      // Friends subcollection: readable/deletable by either party.
      // Writes are limited to the expected profile fields so neither party
      // can smuggle arbitrary data into the other user's subcollection.
      match /friends/{friendUid} {
        allow read, delete: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == friendUid
        );
        allow create, update: if request.auth != null && (
            request.auth.uid == uid ||
            request.auth.uid == friendUid
          )
          && request.resource.data.keys().hasOnly(['display_name', 'avatar_url', 'since'])
          && request.resource.data.get('display_name', '') is string
          && request.resource.data.get('display_name', '').size() <= 100
          && request.resource.data.get('avatar_url', '') is string
          && request.resource.data.get('avatar_url', '').size() <= 500;
      }
    }

    // Groups: readable by members, creatable only with yourself as creator+member,
    // updatable by members (creator is immutable), deletable only by the creator.
    match /groups/{groupId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        // Membership: the creator may remove anyone; other members may only
        // add people or remove themselves (all prior members minus the
        // requester must still be present).
        && (
          request.auth.uid == resource.data.created_by ||
          request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.created_by;
    }
  }
}
