rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Song einer Story: null oder Map mit hoechstens id, title, artist, cover_url (Strings).
    function songOk(song) {
      return song == null || (
        song is map
        && song.keys().hasOnly(['id', 'title', 'artist', 'cover_url'])
        && song.get('id', '') is string
        && song.get('title', '') is string
        && song.get('artist', '') is string
        && song.get('cover_url', '') is string
        && song.get('cover_url', '').size() <= 500
      );
    }

    // Invite lookup: token → { uid, display_name, avatar_url }.
    // Tokens are unguessable UUIDs; get-only (no list, so no enumeration).
    // Only the owning user can create/overwrite/delete their invite doc.
    match /invites/{token} {
      allow get: if request.auth != null;
      // list nur fuer die eigenen Invite-Docs, also nur ueber eine Query,
      // die auf die eigene uid filtert. Gebraucht von der Kontoloeschung,
      // um ein verwaistes Invite nach einem Teil-Durchlauf noch zu finden.
      // Enumeration fremder Invites bleibt unmoeglich.
      allow list: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'display_name', 'avatar_url'])
        && request.resource.data.get('display_name', '') is string
        && request.resource.data.get('display_name', '').size() <= 100
        && request.resource.data.get('avatar_url', '') is string
        && request.resource.data.get('avatar_url', '').size() <= 500;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'display_name', 'avatar_url'])
        && request.resource.data.get('display_name', '') is string
        && request.resource.data.get('display_name', '').size() <= 100
        && request.resource.data.get('avatar_url', '') is string
        && request.resource.data.get('avatar_url', '').size() <= 500;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Users: readable only by the owner and confirmed friends (friend view).
    // No list — invite lookup goes through /invites instead.
    // Write: only by the user themselves, with type/size validation
    match /users/{uid} {
      allow get: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
      );
      allow list: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('display_name', '') is string
        && request.resource.data.get('display_name', '').size() <= 100
        && request.resource.data.get('avatar_url', '') is string
        && request.resource.data.get('avatar_url', '').size() <= 500
        && request.resource.data.get('invite_token', '') is string
        && request.resource.data.get('invite_token', '').size() <= 64
        && request.resource.data.get('visited_countries', [])  is list
        && request.resource.data.get('wishlist_countries', []) is list
        && request.resource.data.get('visited_cities', [])     is list
        && request.resource.data.get('visited_cities', []).size() <= 5000
        && request.resource.data.get('wishlist_cities', [])    is list
        && request.resource.data.get('wishlist_cities', []).size() <= 5000
        && request.resource.data.get('consent', {'version': 0}) is map
        && request.resource.data.get('consent', {'version': 0}).get('version', 0) is int;

      // Friends subcollection: readable/deletable by either party.
      // Writes are limited to the expected profile fields so neither party
      // can smuggle arbitrary data into the other user's subcollection.
      // Story-Zugriff haengt an diesem Eintrag. Deshalb darf sich die Gegenseite
      // nur mit dem Token aus dem Einladungslink selbst eintragen (Invite von uid).
      match /friends/{friendUid} {
        allow read, delete: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == friendUid
        );
        allow create: if request.auth != null
          && (
            request.auth.uid == uid
            || (
              request.auth.uid == friendUid
              && request.resource.data.get('token', null) is string
              && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.uid == uid
            )
          )
          && request.resource.data.keys().hasOnly(['display_name', 'avatar_url', 'since', 'token'])
          && request.resource.data.get('display_name', '') is string
          && request.resource.data.get('display_name', '').size() <= 100
          && request.resource.data.get('avatar_url', '') is string
          && request.resource.data.get('avatar_url', '').size() <= 500
          && request.resource.data.get('token', '') is string
          && request.resource.data.get('token', '').size() <= 64;
        allow update: if request.auth != null && (
            request.auth.uid == uid ||
            request.auth.uid == friendUid
          )
          && request.resource.data.keys().hasOnly(['display_name', 'avatar_url', 'since', 'token'])
          && request.resource.data.get('display_name', '') is string
          && request.resource.data.get('display_name', '').size() <= 100
          && request.resource.data.get('avatar_url', '') is string
          && request.resource.data.get('avatar_url', '').size() <= 500
          && request.resource.data.get('token', '') == resource.data.get('token', '');
      }

      // Stories: privat, ein Freund liest nur mit shared == true. Die Query
      // des Freundes muss daher where('shared', '==', true) enthalten.
      match /stories/{storyId} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          (resource.data.shared == true &&
           exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)))
        );
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['city', 'country', 'date', 'text', 'photos', 'voice', 'song', 'shared', 'created_at'])
          && request.resource.data.city is string
          && request.resource.data.city.size() >= 1 && request.resource.data.city.size() <= 200
          && request.resource.data.get('country', '') is string
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 2000
          && request.resource.data.get('photos', []) is list
          && request.resource.data.get('photos', []).size() <= 10
          && request.resource.data.shared is bool
          && songOk(request.resource.data.get('song', null));
      }
    }

    // Groups: readable by members, creatable only with yourself as creator+member,
    // updatable by members (creator is immutable), deletable only by the creator.
    match /groups/{groupId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        // created_by ist normalerweise unveraenderlich. Einzige Ausnahme ist
        // die Uebergabe bei Kontoloeschung: nur der aktuelle Ersteller, nur
        // waehrend er selbst austritt, und nur an jemanden, der Mitglied bleibt.
        && (
          request.resource.data.created_by == resource.data.created_by
          || (
            request.auth.uid == resource.data.created_by
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.created_by in request.resource.data.members
          )
        )
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        // Membership: the creator may remove anyone; other members may only
        // add people or remove themselves (all prior members minus the
        // requester must still be present).
        && (
          request.auth.uid == resource.data.created_by ||
          request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
        );

      // Der Ersteller darf loeschen. Dazu ein Sicherheitsnetz: Ein letztes
      // verbliebenes Mitglied darf die Gruppe auch dann aufloesen, wenn der
      // Ersteller ein bereits geloeschtes Konto ist.
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.created_by
        || (request.auth.uid in resource.data.members
            && resource.data.members.size() == 1)
      );
    }
  }
}
